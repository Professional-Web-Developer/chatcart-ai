# ChatCart AI - copy to .env.local and fill in. Nothing here is required to build or start the app;
# missing values show a setup notice instead.

# PayPal sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client id, exposed to the browser for the PayPal buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional. Defaults to the sandbox. Use https://api-m.paypal.com only for live payments.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI provider: set ONE key. Auto-detected in this order: Google, Anthropic, OpenAI.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model id override (defaults: gemini-flash-latest / claude-haiku-5-5 / gpt-5.4-mini)
AI_MODEL=

# Optional Postgres (e.g. Neon). If empty, orders are kept in memory and reset on restart.
DATABASE_URL=

# Owner PIN for the built-in demo shop "Anu's Home Bakery" (6 digits). Judges: default is 246810.
# Shops created via /new get their own random PIN, shown once and stored only as a scrypt hash.
OWNER_PIN=246810

# PayPal webhook id (from the webhook you register for POST /api/webhooks/paypal in the PayPal developer
# dashboard; events: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED, INVOICING.INVOICE.PAID).
# When empty the endpoint answers 503 and never trusts unverified events.
PAYPAL_WEBHOOK_ID=
