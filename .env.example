# ChatCart AI - copy this file to .env.local and fill it in. No real values here.
# Nothing is required to build or start the app. Missing values show a "Setup needed" banner.
# Step-by-step help: docs/SETUP.md

# ---------------------------------------------------------------------------
# PayPal (sandbox)
# Get these at https://developer.paypal.com > Apps & Credentials > Sandbox > Create App (Merchant).
# SANDBOX COUNTRY NOTE: PayPal does not support payments between two Indian accounts, and the sandbox
# follows the same rule. Pay with a sandbox Personal buyer whose country is United States. If that still
# fails, create a United States Business sandbox account, create the app under it, and use its keys.
# ---------------------------------------------------------------------------

# Required for payments. Sandbox app Client ID (used by the server).
PAYPAL_CLIENT_ID=
# Required for payments. Sandbox app Secret. Server only, never sent to the browser.
PAYPAL_CLIENT_SECRET=
# Required for payments. The same Client ID again, for the PayPal button in the browser. Set before build.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional. PayPal API address. Default is the sandbox. Keep it as is for this project.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional. Webhook id from the PayPal dashboard (URL: https://<your-domain>/api/webhooks/paypal;
# events PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED, INVOICING.INVOICE.PAID).
# When empty, the webhook route answers 503 and ignores all events.
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# AI provider: set ONE key. The first one found is used, in this order:
# Google, Groq, Anthropic, OpenAI. The live demo uses Groq (free tier).
# ---------------------------------------------------------------------------

# Optional (one AI key is required). Get it at https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional (one AI key is required). Recommended, free tier. Get it at https://console.groq.com
GROQ_API_KEY=
# Optional (one AI key is required). Get it at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional (one AI key is required). Get it at https://platform.openai.com
OPENAI_API_KEY=
# Optional. Model id for the provider that is detected.
# Defaults: gemini-flash-latest, openai/gpt-oss-120b, claude-haiku-5-5, gpt-5.4-mini
AI_MODEL=
# Optional: comma-separated backup model ids (same provider) used when the main model hits its limit.
AI_FALLBACK_MODELS=

# ---------------------------------------------------------------------------
# Storage and access
# ---------------------------------------------------------------------------

# Optional but recommended on Vercel. Postgres connection string, for example from https://neon.tech
# When empty, orders and shops are kept in memory and are lost on restart.
DATABASE_URL=

# Optional. 6-digit owner PIN of the built-in demo shop "Anu's Home Bakery". Default is 246810 (public).
# Shops created at /new get their own random PIN, which is stored only as a salted hash.
OWNER_PIN=246810
